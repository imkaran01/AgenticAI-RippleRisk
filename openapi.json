{
  "openapi": "3.1.0",
  "info": {
    "title": "RippleRisk Economic Shock Analyzer API",
    "version": "1.0.0",
    "description": "REST API adapter for the RippleRisk HTML economic engine. Outputs are illustrative, hard-coded model results and are not empirically calibrated forecasts."
  },
  "servers": [
    {
      "url": "https://YOUR-DEPLOYED-HOST"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/sectors": {
      "get": {
        "summary": "List supported sectors",
        "operationId": "listSectors",
        "responses": {
          "200": {
            "description": "List of sectors returned"
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "summary": "Analyze an economic shock",
        "operationId": "analyzeEconomicShock",
        "description": "Runs the RippleRisk model. If using semiconductor components as the origin, the request is mapped to the Electronics node as a proxy.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              },
              "example": {
                "shock_type": "cost-increase",
                "shock_magnitude_percent": 20,
                "direction": "increase",
                "affected_sector": "semiconductor components",
                "target_industry": "wireless earbuds",
                "business_context": "Illustrative business scenario for a hackathon demonstration. Compare modeled propagation, not company-specific pricing forecasts.",
                "duration": "persistent",
                "horizon_months": 6,
                "scenario": "base"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model results returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/compare-scenarios": {
      "post": {
        "summary": "Compare scenario summaries",
        "operationId": "compareEconomicScenarios",
        "description": "Runs the same shock under optimistic, base, and adverse model scenarios.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scenario summaries returned"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AnalyzeRequest": {
        "type": "object",
        "properties": {
          "shock_type": {
            "type": "string",
            "enum": [
              "price-increase",
              "cost-increase",
              "demand-decline",
              "interest-rate",
              "tax-change",
              "supply-disruption",
              "exchange-rate"
            ],
            "description": "Supported shock type."
          },
          "shock_magnitude_percent": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 100,
            "description": "Shock magnitude. For interest-rate shocks, magnitude is modeled in percentage points."
          },
          "direction": {
            "type": "string",
            "enum": [
              "increase",
              "decrease"
            ],
            "default": "increase"
          },
          "affected_sector": {
            "type": "string",
            "description": "Sector at the origin of the shock. Use a sector ID or display name from GET /sectors. Semiconductor components are mapped to Electronics as a proxy."
          },
          "target_industry": {
            "type": "string",
            "description": "Optional target industry for contextual interpretation; it does not change the model calculation."
          },
          "business_context": {
            "type": "string",
            "description": "Optional context; does not change model calculation."
          },
          "duration": {
            "type": "string",
            "enum": [
              "temporary",
              "persistent"
            ],
            "default": "temporary"
          },
          "horizon_months": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 6
          },
          "scenario": {
            "type": "string",
            "enum": [
              "optimistic",
              "base",
              "adverse",
              "custom"
            ],
            "default": "base"
          },
          "elasticity_multiplier": {
            "type": "number",
            "minimum": 0,
            "default": 1
          },
          "pass_through_multiplier": {
            "type": "number",
            "minimum": 0,
            "default": 1
          }
        },
        "required": [
          "shock_type",
          "shock_magnitude_percent",
          "affected_sector"
        ],
        "additionalProperties": false
      }
    }
  }
}
