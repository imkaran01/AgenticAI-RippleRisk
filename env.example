# Optional. If set, all POST requests require Authorization: Bearer <key> or X-API-Key.
# Configure the same secret in Leah's API tool after deployment.
RIPPLERISK_API_KEY=
# Comma-separated origins. Use * for MVP testing only; restrict for production if browser callers need CORS.
ALLOWED_ORIGINS=*
PORT=3000
RATE_LIMIT_PER_MINUTE=60
